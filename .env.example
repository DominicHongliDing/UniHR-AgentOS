# 唯一必须填写的配置：阿里云百炼 / DashScope API Key
UNIHR_BAILIAN_API_KEY=replace-with-your-dashscope-api-key

# 百炼 OpenAI 兼容接口与模型路由。默认即可运行，也可以按账号可用模型调整。
UNIHR_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UNIHR_ROUTER_MODEL=qwen3.7-flash
UNIHR_ROUTER_FALLBACK_MODEL=qwen-plus
UNIHR_PRIMARY_MODEL=qwen3.8-max-preview
UNIHR_PRIMARY_FALLBACK_MODEL=qwen3.7-max
UNIHR_PRIMARY_LAST_RESORT_MODEL=qwen-plus
UNIHR_DOCUMENT_MODEL=qwen3.7-max
UNIHR_VISION_MODEL=qwen3.7-plus
UNIHR_OCR_MODEL=qwen-vl-ocr
UNIHR_EMBEDDING_MODEL=qwen3.7-text-embedding
UNIHR_EMBEDDING_DIMENSIONS=768
UNIHR_RERANK_MODEL=qwen3-rerank

# LangGraph 持久化。setup.ps1 会自动启动本地 PostgreSQL 容器。
UNIHR_POSTGRES_PASSWORD=unihr_local_only
UNIHR_WORKFLOW_POSTGRES_DSN=postgresql://unihr:unihr_local_only@127.0.0.1:55432/unihr_workflows?sslmode=disable
UNIHR_QUALITY_POSTGRES_DSN=postgresql://unihr:unihr_local_only@127.0.0.1:55432/unihr_workflows?sslmode=disable

# 本地演示账号。部署到共享环境前请务必修改。
UNIHR_ADMIN_USERNAME=admin
UNIHR_ADMIN_PASSWORD=UniHR@2026
UNIHR_DEMO_USERNAME=hr-user
UNIHR_DEMO_PASSWORD=UniHR@2026
APP_JWT_SECRET_KEY=change-this-before-shared-deployment

# 默认把用户上传的政策保存到 backend/data/knowledge-source，不扫描电脑其他目录。
# UNIHR_KNOWLEDGE_SOURCE_ROOT=D:\your-private-policy-folder

# Office 原生渲染是可选增强；关闭时仍可生成 Word / Excel。
UNIHR_EXCEL_AUTOMATION_ENABLED=false
UNIHR_WORD_AUTOMATION_ENABLED=false

# 公共信息检索。无需额外 Key 的能力默认开启；MCP 可按需配置。
UNIHR_PUBLIC_SEARCH_ENABLED=true
UNIHR_CMA_WEATHER_ENABLED=true
UNIHR_EXA_MCP_ENABLED=false
UNIHR_TAVILY_MCP_ENABLED=false
UNIHR_TAVILY_API_KEY=
UNIHR_FIRECRAWL_MCP_ENABLED=false
UNIHR_FIRECRAWL_API_KEY=

# 飞书数字员工是可选能力，不影响 Web 工作台。
UNIHR_FEISHU_CHANNEL_ENABLED=false
UNIHR_FEISHU_APP_ID=
UNIHR_FEISHU_APP_SECRET=
UNIHR_FEISHU_CHANNEL_MODE=webhook

